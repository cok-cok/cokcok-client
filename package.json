{
  "name": "cokcok-client",
  "version": "0.0.1",
  "main": "index.ts",
  "scripts": {
    "eas-build-pre-install": "corepack enable && corepack prepare yarn@4.12.0 --activate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:dry": "commit-and-tag-version --dry-run",
    "start": "expo start --port 8082",
    "android": "expo run:android --port 8082",
    "ios": "expo run:ios --port 8082",
    "ios:build:dev": "eas build --platform ios --profile dev",
    "ios:build:rel": "eas build --platform ios --profile rel",
    "ios:build:prod": "eas build --platform ios --profile prod",
    "ios:build:dev:ci": "eas build --platform ios --profile dev --non-interactive",
    "ios:build:rel:ci": "eas build --platform ios --profile rel --non-interactive",
    "ios:build:prod:ci": "eas build --platform ios --profile prod --non-interactive",
    "android:build:dev": "eas build --platform android --profile dev",
    "android:build:rel": "eas build --platform android --profile rel",
    "android:build:prod": "eas build --platform android --profile prod",
    "android:build:dev:ci": "eas build --platform android --profile dev --non-interactive",
    "android:build:rel:ci": "eas build --platform android --profile rel --non-interactive",
    "android:build:prod:ci": "eas build --platform android --profile prod --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "commit-and-tag-version": "^12.7.1",
    "eslint": "^9",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "5.9.2"
  },
  "private": true,
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
